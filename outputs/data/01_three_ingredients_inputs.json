{
  "problem": "Wyndor Glass product mix (Hillier & Lieberman)",
  "decision_variables": {
    "d": "number of doors to make",
    "w": "number of windows to make"
  },
  "objective": {
    "direction": "maximize",
    "coefficients": {
      "doors": 3.0,
      "windows": 5.0
    }
  },
  "constraints": [
    {
      "name": "plant1",
      "usage": {
        "doors": 1.0
      },
      "limit": 4.0,
      "sense": "<="
    },
    {
      "name": "plant2",
      "usage": {
        "windows": 2.0
      },
      "limit": 12.0,
      "sense": "<="
    },
    {
      "name": "plant3",
      "usage": {
        "doors": 3.0,
        "windows": 2.0
      },
      "limit": 18.0,
      "sense": "<="
    }
  ],
  "nonnegativity": "d, w >= 0"
}